# ===== Środowisko =====
# production (domyślnie) wyłącza /docs i /openapi.json. Lokalnie: development.
ENVIRONMENT=production

# ===== Baza =====
# PRODUKCJA / STAGING (mydevil, serwer s61 → pgsql61):
DATABASE_URL=postgresql+psycopg://UZYTKOWNIK:HASLO@pgsql61.mydevil.net:5432/NAZWA_BAZY
# LOKALNIE:
# DATABASE_URL=postgresql+psycopg://ksiegowosc:HASLO@localhost:5432/ksiegowosc_dev
# Osobna baza TYLKO dla pytest — testy kasują i odtwarzają jej schemat.
# DATABASE_URL_TEST=postgresql+psycopg://ksiegowosc:HASLO@localhost:5432/ksiegowosc_test

# ===== Logowanie =====
# Identyfikator OSOBNEGO projektu Firebase księgowości (nie CRM). Backend tylko weryfikuje
# tokeny publicznymi certyfikatami Google — nie potrzebuje klucza konta serwisowego.
FIREBASE_PROJECT_ID=

# ===== CORS =====
# Na produkcji front i API są pod jedną domeną, więc zwykle puste.
# Lokalnie: http://localhost:5173
CORS_ORIGINS=
